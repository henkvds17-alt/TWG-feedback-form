# ---- Test before you pay ----
# Set to "true" to skip all paid OpenAI calls and use canned test content
# instead (Supabase + Google Sheets writes still happen for real). Great
# for testing the whole app for free before adding OpenAI billing. Set
# back to "false" (or remove it) before going live with real kids.
MOCK_MODE=false

# ---- OpenAI (speech-to-text, the conversation itself, and text-to-speech) ----
# One key covers all three - transcription, chat, and voice. Not required
# at all while MOCK_MODE=true.
OPENAI_API_KEY=

# Optional model overrides - defaults shown are the cheap/fast choices this
# app was built around. Only change these if you know what you're doing.
# CONVERSATION_MODEL=gpt-4o-mini
# ANALYSIS_MODEL=gpt-4o-mini
# STT_MODEL=gpt-4o-mini-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=onyx
# TTS_INSTRUCTIONS=(override the warm/friendly delivery style - only used by gpt-4o-mini-tts)

# ---- Optional: Google review link on the thank-you screen ----
# Leave blank until you've set up a Google Business Profile - the review
# button only shows up once this is filled in. No redeploy needed to add
# it later, just set the env var and redeploy.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# ---- Supabase (database, source of truth) ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Sheets (easy-review copy) ----
# Service account JSON, from Google Cloud Console. Paste the whole single-line JSON string.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
